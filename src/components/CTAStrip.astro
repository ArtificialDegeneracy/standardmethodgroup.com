---
interface Props {
  headline?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  headline = '30 minutes. No pitch. Just a conversation about your operations.',
  buttonText = 'Book a discovery call',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="cta-strip">
  <div class="cta-texture" aria-hidden="true"></div>
  <div class="cta-inner">
    <h2 class="cta-headline">{headline}</h2>
    <a href={buttonHref} class="cta-button">{buttonText}</a>
  </div>
</section>

<style>
  .cta-strip {
    position: relative;
    overflow: hidden;
    background: var(--color-navy);
    padding: var(--space-12) 0;
    isolation: isolate;
  }

  .cta-texture {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 90% at 50% 50%, #000 25%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 80% 90% at 50% 50%, #000 25%, transparent 72%);
  }

  .cta-inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-3);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .cta-headline {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.75rem;
    color: var(--color-white);
    line-height: 1.2;
    max-width: 640px;
  }

  .cta-button {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1rem;
    color: var(--color-white);
    background: var(--color-teal);
    padding: 15px 30px;
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transition: background 200ms var(--ease), transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }

  .cta-button:hover {
    background: var(--color-deep-teal);
    color: var(--color-white);
    transform: var(--lift);
    box-shadow: var(--shadow-lg);
  }

  .cta-button:focus-visible {
    outline: 3px solid rgba(42, 125, 110, 0.4);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .cta-strip {
      padding: var(--space-8) 0;
    }

    .cta-headline {
      font-size: 1.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }
    .cta-button:hover {
      transform: none;
    }
  }
</style>
