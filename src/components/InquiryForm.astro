---
// Inquiry form. Renders only when src/data/site.json has a Formspree endpoint
// (for example "https://formspree.io/f/xxxxxxx"). Without one, nothing is shown
// and the booking link and email remain the contact methods.
import site from '../data/site.json';
const endpoint = site.inquiryEndpoint;
---

{endpoint && (
  <form class="inquiry" action={endpoint} method="POST" data-inquiry>
    <h2 class="inquiry-title">Tell us what's costing you the most</h2>
    <p class="inquiry-lede">We reply within one business day. No sales sequence.</p>

    <div class="field">
      <label for="iq-name">Name</label>
      <input id="iq-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="iq-email">Email</label>
      <input id="iq-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="iq-business">Business name</label>
      <input id="iq-business" name="business" type="text" autocomplete="organization" />
    </div>
    <div class="field">
      <label for="iq-problem">What problem is costing you the most right now?</label>
      <textarea id="iq-problem" name="problem" rows="4" required></textarea>
    </div>
    <div class="field">
      <label for="iq-phone">Phone <span class="optional">(optional)</span></label>
      <input id="iq-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div class="field">
      <label for="iq-source">How did you hear about us? <span class="optional">(optional)</span></label>
      <input id="iq-source" name="source" type="text" />
    </div>

    <!-- Honeypot: hidden from people, filled by bots -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

    <button type="submit" class="inquiry-submit">Send message</button>
    <p class="inquiry-status" role="status" aria-live="polite"></p>
  </form>
)}

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
    if (!form) return;
    const status = form.querySelector('.inquiry-status') as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = 'Sending...';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('bad status');
        form.reset();
        status.textContent = 'Thanks. We will reply within one business day.';
      } catch {
        status.textContent = 'That did not send. Please email dan@standardmethodgroup.com instead.';
      }
    });
  });
</script>

<style>
  .inquiry {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-5) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .inquiry-title {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.375rem;
    color: var(--color-navy);
  }

  .inquiry-lede { color: var(--color-text-secondary); margin-bottom: var(--space-1); }

  .field { display: flex; flex-direction: column; gap: 6px; }

  label {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: 0.9375rem;
    color: var(--color-navy);
  }

  .optional { font-weight: 400; color: var(--color-text-secondary); }

  input, textarea {
    font: inherit;
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-text);
  }

  input:focus-visible, textarea:focus-visible {
    outline: 3px solid rgba(42, 125, 110, 0.4);
    outline-offset: 1px;
    border-color: var(--color-teal);
  }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .inquiry-submit {
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1rem;
    color: var(--color-white);
    background: var(--color-teal);
    border: none;
    border-radius: var(--radius);
    padding: 14px 28px;
  }

  .inquiry-submit:hover { background: var(--color-deep-teal); }

  .inquiry-status { min-height: 1.5em; font-size: 0.9375rem; color: var(--color-deep-teal); }
</style>
