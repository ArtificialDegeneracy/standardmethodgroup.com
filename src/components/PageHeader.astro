---
import Hero from './Hero.astro';
interface Props {
  headline: string;
  subheadline?: string;
  eyebrow?: string;
}
const { headline, subheadline, eyebrow } = Astro.props;
---

<Hero compact>
  {eyebrow && <span class="page-header-eyebrow">{eyebrow}</span>}
  <h1 class="page-header-headline">{headline}</h1>
  {subheadline && (
    <p class="page-header-sub">{subheadline}</p>
  )}
</Hero>

<style>
  .page-header-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5FC9B5;
    margin-bottom: var(--space-2);
  }

  .page-header-headline {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 2.75rem;
    color: var(--color-white);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .page-header-sub {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.6;
    margin-top: var(--space-3);
    max-width: 680px;
  }

  @media (max-width: 768px) {
    .page-header-headline {
      font-size: 1.875rem;
    }
    .page-header-sub {
      font-size: 1.125rem;
    }
  }
</style>
