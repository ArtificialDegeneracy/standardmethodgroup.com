---
interface Props {
  question: string;
}
const { question } = Astro.props;
---

<li class="step">
  <h3 class="step-q">{question}</h3>
  <div class="step-body"><slot /></div>
</li>

<style>
  .step {
    counter-increment: step;
    position: relative;
    border-top: 3px solid var(--color-navy);
    padding: var(--space-3) 0 var(--space-5) 0;
  }

  .step:last-child { padding-bottom: 0; }

  /* The order carries meaning, so the numeral is content: it is also in the ordered list semantics. */
  .step::before {
    content: counter(step);
    display: block;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--color-deep-teal);
    margin-bottom: var(--space-1);
  }

  .step-q {
    font-size: 1.375rem;
    letter-spacing: var(--tracking-heading);
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }

  .step-body > :global(*:first-child) { margin-top: 0; }

  @media (min-width: 880px) {
    /* Numeral sits in a left rail, hanging outside the 40rem text column. */
    .step {
      padding-left: 0;
    }
    .step::before {
      position: absolute;
      left: -72px;
      top: var(--space-3);
      width: 48px;
      text-align: right;
      margin: 0;
    }
  }
</style>
