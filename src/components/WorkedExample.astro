---
// Illustrative arithmetic only. Always labelled as made-up numbers, never as a client result.
// Time mode: pass jobs/before/after. Custom mode: pass cells (last one is highlighted) and math.
interface Props {
  jobs?: number;
  before?: number; // minutes per job today
  after?: number; // minutes per job after the fix
  cells?: { label: string; value: string }[];
  math?: string;
}
const { jobs = 0, before = 0, after = 0, cells, math } = Astro.props;
const hoursBefore = (jobs * before) / 60;
const hoursAfter = (jobs * after) / 60;
const saved = hoursBefore - hoursAfter;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const items = cells ?? [
  { label: 'jobs per month', value: String(jobs) },
  { label: `at ${before} minutes per job`, value: `${fmt(hoursBefore)} hours` },
  { label: `saved at ${after} minutes per job`, value: `about ${Math.round(saved)} hours` },
];
const mathText = math ?? `${jobs} jobs × ${before} minutes = ${fmt(hoursBefore)} hours. ${jobs} jobs × ${after} minutes ≈ ${fmt(Math.round(hoursAfter * 10) / 10)} hours. The difference is about ${Math.round(saved)} hours a month.`;
---

<figure class="example">
  <figcaption class="example-label">Illustrative example based on hypothetical figures.</figcaption>
  <dl class="example-calc">
    {items.map((c, i) => (
      <div class:list={['cell', { 'cell-saved': i === items.length - 1 }]}>
        <dt>{c.label}</dt>
        <dd>{c.value}</dd>
      </div>
    ))}
  </dl>
  <p class="example-math">{mathText}</p>
</figure>

<style>
  .example {
    margin: var(--space-5) 0;
    border-top: 3px solid var(--color-navy);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-3) 0;
  }

  .example-label {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }

  .example-calc {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .cell {
    display: flex;
    flex-direction: column-reverse; /* figure first, label beneath; the source order stays label then value */
    justify-content: flex-end;
    gap: 4px;
  }

  .cell dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.75rem;
    letter-spacing: var(--tracking-heading);
    line-height: 1.15;
    color: var(--color-navy);
  }

  .cell dt {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
  }

  .cell-saved dd { color: var(--color-deep-teal); }

  /* Two classes so the article's `.note-body p` margin does not override this. */
  .example .example-math {
    margin: var(--space-3) 0 0;
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .example-calc { grid-template-columns: 1fr; gap: 0; }
    .cell {
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-2) 0;
    }
    .cell:first-child { padding-top: 0; }
    .cell:last-child { border-bottom: none; padding-bottom: 0; }
  }
</style>
