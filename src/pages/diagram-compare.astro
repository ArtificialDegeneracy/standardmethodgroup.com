---
// Temporary visual-review page: current hero diagram vs proposed MethodDiagram.
// Not linked anywhere. Delete before merging (see audit notes).
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/tokens.css';
import '../styles/global.css';
import MethodDiagram from '../components/MethodDiagram.astro';

const widths = [
  { label: 'Desktop hero, 1440 px viewport', w: 422 },
  { label: 'Narrow two-column hero, about 960 px viewport', w: 340 },
  { label: 'Phone, 375 px viewport', w: 327 },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Diagram comparison (temporary)</title>
  </head>
  <body>
    <main class="page">
      <h1>Hero diagram: current vs proposed</h1>
      <p class="lede">Each row shows both at the width the hero figure actually gets. Reload to replay the animation.</p>

      {widths.map((r) => (
        <section class="row">
          <h2>{r.label}</h2>
          <div class="pair">
            <div class="cell" style={`width:${r.w}px`}>
              <p class="tag">Current</p>
              <figure class="old-figure">
        <svg class="flow" viewBox="0 0 440 380" role="img" aria-labelledby="flow-title flow-desc">
          <title id="flow-title">How one enquiry moves through a system</title>
          <desc id="flow-desc">Phone calls, texts, emails, and paper notes all feed a single record. From that record the owner is notified, a follow-up is scheduled, and the outcome appears in a monthly report.</desc>

          <g class="flow-inputs">
            <rect class="node" x="0" y="16" width="148" height="44" rx="6" />
            <text class="node-label" x="16" y="43">Phone call</text>
            <rect class="node" x="0" y="84" width="148" height="44" rx="6" />
            <text class="node-label" x="16" y="111">Text message</text>
            <rect class="node" x="0" y="152" width="148" height="44" rx="6" />
            <text class="node-label" x="16" y="179">Email</text>
            <rect class="node" x="0" y="220" width="148" height="44" rx="6" />
            <text class="node-label" x="16" y="247">Paper and notes</text>
          </g>

          <g class="flow-lines" fill="none">
            <path class="flow-line" style="--i:0" pathLength="1" d="M148 38 C180 38 180 140 212 140" />
            <path class="flow-line" style="--i:1" pathLength="1" d="M148 106 C180 106 180 146 212 146" />
            <path class="flow-line" style="--i:2" pathLength="1" d="M148 174 C180 174 180 154 212 154" />
            <path class="flow-line" style="--i:3" pathLength="1" d="M148 242 C180 242 180 160 212 160" />
            <path class="flow-line" style="--i:5" pathLength="1" d="M307 182 V214" />
            <path class="flow-line" style="--i:6" pathLength="1" d="M307 254 V268" />
            <path class="flow-line" style="--i:7" pathLength="1" d="M307 308 V322" />
          </g>

          <rect class="hub" x="212" y="118" width="190" height="64" rx="8" />
          <text class="hub-label" x="232" y="146">One record</text>
          <text class="hub-sub" x="232" y="166">Logged once, with a status</text>

          <g class="flow-outputs">
            <rect class="node" x="212" y="214" width="190" height="40" rx="6" />
            <circle class="dot" cx="230" cy="234" r="4" />
            <text class="node-label" x="244" y="239">Owner notified</text>
            <rect class="node" x="212" y="268" width="190" height="40" rx="6" />
            <circle class="dot" cx="230" cy="288" r="4" />
            <text class="node-label" x="244" y="293">Follow-up scheduled</text>
            <rect class="node" x="212" y="322" width="190" height="40" rx="6" />
            <circle class="dot" cx="230" cy="342" r="4" />
            <text class="node-label" x="244" y="347">Monthly report</text>
          </g>
        </svg>
        <figcaption>Illustrative: how one enquiry can move through a system we design.</figcaption>
      </figure>
            </div>
            <div class="cell" style={`width:${r.w}px`}>
              <p class="tag tag-new">Proposed</p>
              <MethodDiagram idPrefix={`m${r.w}`} />
            </div>
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style is:global>
  body { background: var(--color-navy); color: #fff; }
</style>

<style>
  .page { max-width: 1000px; margin: 0 auto; padding: 48px 24px 96px; }
  h1 { font-size: 1.75rem; color: #fff; }
  .lede { color: rgba(255,255,255,.7); margin: 8px 0 40px; }
  .row { margin-bottom: 56px; }
  h2 { font-size: 0.8125rem; letter-spacing: .08em; text-transform: uppercase; color: var(--color-teal-light); margin-bottom: 16px; font-weight: 500; }
  .pair { display: flex; gap: 32px; flex-wrap: wrap; align-items: flex-start; }
  .tag { font-family: var(--font-heading); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.55); margin-bottom: 8px; }
  .tag-new { color: var(--color-teal-light); }

  /* Hero figure */
  .old-figure {
    padding: var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.035);
  }

  .old-figure figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.58);
  }

  .flow { display: block; width: 100%; height: auto; }

  .flow .node {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1;
  }

  .flow .node-label {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 15px;
    fill: rgba(255, 255, 255, 0.9);
  }

  .flow .hub { fill: var(--color-teal); }

  .flow .hub-label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    fill: var(--color-white);
  }

  .flow .hub-sub {
    font-family: var(--font-heading);
    font-size: 12.5px;
    fill: rgba(255, 255, 255, 0.82);
  }

  .flow .dot { fill: var(--color-teal-light); }

  .flow .flow-line {
    stroke: var(--color-teal-light);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow .flow-line {
      stroke-dasharray: 1;
      animation: flow-draw 0.9s ease-out both;
      animation-delay: calc(0.5s + var(--i) * 0.12s);
    }
  }

  @keyframes flow-draw {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }


</style>
