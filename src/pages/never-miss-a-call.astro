---
// Transition page. The URL was used in earlier outreach, so it stays live.
// GitHub Pages cannot issue HTTP redirects, so this page explains and points to /services/.
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
---

<Base noindex canonical="https://standardmethodgroup.com/services/">
  <ServiceHero
    eyebrow="Call coverage"
    headline="Call coverage is one way we fix a problem. It is not where we start."
    sub="If missed calls are costing you work, we may recommend a system that answers, captures the details, and books the meeting. We recommend it when it fits what we find, alongside or instead of other fixes."
    primaryText="See our services"
    primaryHref="/services"
    secondaryText="Book a 30-minute call"
    secondaryHref="/contact"
  />

  <section class="sx-section">
    <div class="sx-wrap-narrow">
      <p class="sx-kicker">What we do instead</p>
      <h2 class="sx-title">We start with the problem and choose the fix after.</h2>
      <p class="sx-lead">Sometimes the answer to a missed-call problem is a voice system. Sometimes it is a change to who picks up, a faster follow-up, or a better handoff. We look at how your business runs first, then recommend what fits.</p>
      <p class="sx-lead">You can see how we work on the <a class="sx-link" href="/services">services page</a>, or <a class="sx-link" href="/contact">book a 30-minute call</a> and describe what is going on.</p>
    </div>
  </section>
</Base>
