---
import Base from '../../layouts/Base.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import CycleDiagram from '../../components/CycleDiagram.astro';
import CTAStrip from '../../components/CTAStrip.astro';

// Four reasons to buy. The full list of deliverables sits in the scope section below.
const benefits = [
  {
    title: "Know where to start",
    body: "We assess your business, identify practical opportunities for AI and automation, and build a prioritized 90-day roadmap.",
  },
  {
    title: "Make real progress",
    body: "Two 45-minute working sessions each month, with practical guidance and hands-on help putting improvements in place.",
  },
  {
    title: "Have someone to ask",
    body: "A designated messaging channel for questions, ideas, and guidance between sessions. Initial response within two business days.",
  },
  {
    title: "Know what's improving",
    body: "We keep the roadmap current, review progress, track measurable improvements where possible, and set the next priorities.",
  },
];

const phases = [
  { title: "Assess", body: "The business, your goals, the tools you already have, and where the opportunities are." },
  { title: "Build a roadmap", body: "A prioritized 90-day plan, with the first moves chosen for how much they help and how hard they are." },
  { title: "Work together", body: "Monthly working sessions and ongoing advisory support, with the roadmap adjusted as we learn." },
  { title: "Evaluate", body: "We review progress, document results, and set the next priorities." },
];

const everything = [
  "Business and AI readiness assessment",
  "Personalized, prioritized 90-day roadmap",
  "Two 45-minute working sessions per month",
  "Unlimited reasonable questions through a designated messaging channel, first response within two business days",
  "Ongoing roadmap management and prioritization",
  "Monthly progress report: completed work, current initiatives, results where measurable, next steps",
  "Practical guidance and hands-on help with AI tools, Claude Skills, ChatGPT, automation, forms, documents, custom applications, software integrations, and process improvements",
  "Small improvements completed during working sessions or as agreed",
];

const scopedSeparately = [
  "Larger applications",
  "Production integrations",
  "Substantial automation builds",
  "Ongoing technical maintenance",
];

const faqs = [
  { q: "Do I need to know anything technical?", a: "No. You need to know your business. We bring the tools and the judgment about what is worth doing." },
  { q: "Is this just lessons in how to use ChatGPT?", a: "No. Tool guidance is part of it, but the point is a prioritized roadmap and measurable progress against your business goals, with a report each month." },
  { q: "What if I need something built?", a: "Small improvements can be done in working sessions or as agreed. Anything larger is scoped separately, and you approve the scope before any work starts." },
  { q: "How fast will you reply?", a: "An initial response within two business days, through a messaging channel we set up together." },
  { q: "What does it cost?", a: "We discuss fit and pricing on the consultation call, once we understand what you need." },
];
---

<Base>
  <ServiceHero
    eyebrow="AI Concierge"
    headline="Your AI partner. Without the full-time hire."
    sub="An ongoing advisory relationship for business owners who want to adopt AI, improve how the business runs, and build practical solutions, but do not have the time or expertise to work it all out alone."
    primaryText="Book a consultation"
    primaryHref="/contact"
    secondaryText="See the first 90 days &darr;"
    secondaryHref="#ninety"
  />

  <!-- The situation: one large statement, supporting text beside it -->
  <section class="sx-section situation reveal">
    <div class="sx-wrap situation-grid">
      <h2 class="statement">You know it could help. You do not have time to work out where.</h2>
      <div class="situation-text">
        <p>The tools change every month, and every vendor says theirs will save you hours. Someone still has to decide what is worth doing first, set it up properly, and check that it worked. That is the job here.</p>
        <p>It is a practical, ongoing relationship focused on measurable progress. It is not a generic AI coaching subscription.</p>
      </div>
    </div>
  </section>

  <!-- Four reasons: a connected sequence -->
  <section class="sx-section sx-section-alt benefits reveal">
    <div class="sx-wrap benefits-grid">
      <div class="benefits-head">
        <p class="sx-kicker">What you get</p>
        <h2 class="sx-title">An assessment, a roadmap, and a partner who stays on it.</h2>
        <p class="sx-lead">Four reasons owners bring us in.</p>
      </div>
      <ol class="chain">
        {benefits.map((b, i) => (
          <li>
            <span class="chain-node" aria-hidden="true">{i + 1}</span>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 90 days: steps beside the diagram -->
  <section class="sx-section ninety reveal" id="ninety">
    <div class="sx-wrap">
      <p class="sx-kicker">How it works</p>
      <h2 class="sx-title">The first 90 days, and then the next.</h2>
      <div class="ninety-grid">
        <ol class="phases">
          {phases.map((p, i) => (
            <li>
              <span class="phase-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="diagram"><CycleDiagram /></div>
      </div>
    </div>
  </section>

  <!-- Scope: everything included, and what is scoped separately -->
  <section class="sx-section sx-section-alt scope reveal">
    <div class="sx-wrap">
      <p class="sx-kicker">What is and is not included</p>
      <h2 class="sx-title">Expertise and guidance, not unlimited development.</h2>
      <div class="scope-grid">
        <div class="scope-in">
          <h3>Everything in the monthly relationship</h3>
          <ul>
            {everything.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="scope-out">
          <h3>Scoped and approved separately</h3>
          <ul>
            {scopedSeparately.map((t) => <li>{t}</li>)}
          </ul>
          <p>When something needs a larger build, we scope it, price it, and you approve it before any work starts.</p>
        </div>
      </div>
      <p class="scope-note">You are buying ongoing expertise, guidance, prioritization, and practical assistance. You are not buying unlimited development capacity.</p>
    </div>
  </section>

  <!-- Progress: a distinct band -->
  <section class="progress reveal">
    <div class="sx-wrap progress-grid">
      <div>
        <p class="progress-kicker">Progress you can check</p>
        <h2>Each month ends with a written report.</h2>
      </div>
      <p>It covers completed work, current initiatives, results where they can be measured, and next steps. Where practical we record a starting point first, so the result can be checked. We report honestly on what did not move, and we do not promise outcomes that depend on things outside our control.</p>
    </div>
  </section>

  <section class="sx-section reveal">
    <div class="sx-wrap faq-grid">
      <h2 class="sx-title">Questions owners ask</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.q}</span><span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTAStrip
    headline="Start with a conversation about where AI could help your business."
    buttonText="Book a consultation"
    buttonHref="/contact"
  />
</Base>

<style>
  /* Situation */
  .situation { padding: calc(var(--space-12) + var(--space-3)) 0; }

  .situation-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: start;
  }

  .statement {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    color: var(--color-navy);
    max-width: 16ch;
  }

  .situation-text { padding-top: var(--space-1); }
  .situation-text p { font-size: var(--text-lead); color: var(--color-text-secondary); margin-bottom: var(--space-3); }

  /* Benefits as a connected chain */
  .benefits-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
  }

  .chain {
    list-style: none;
    position: relative;
    padding-left: 72px;
  }

  .chain li { position: relative; padding-bottom: var(--space-5); }
  .chain li:last-child { padding-bottom: 0; }

  /* Connector from each node down to the next */
  .chain li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: -51px;
    top: 44px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--color-teal), var(--color-teal-light));
    opacity: 0.55;
  }

  .chain-node {
    position: absolute;
    left: -72px;
    top: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-teal-light);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1rem;
    box-shadow: 0 0 0 6px var(--color-warm-white-alt);
  }

  .chain h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.625rem;
    letter-spacing: var(--tracking-heading);
    color: var(--color-navy);
    line-height: 1.2;
    padding-top: 6px;
    margin-bottom: var(--space-1);
  }

  .chain p { font-size: 1.1875rem; line-height: 1.55; max-width: 46ch; }

  /* 90 days */
  .ninety-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: center;
  }

  .phases { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  .phases li { display: flex; gap: var(--space-2); }

  .phase-num {
    flex-shrink: 0;
    width: 28px;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-teal);
  }

  .phases h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.0625rem;
    color: var(--color-navy);
    margin-bottom: 2px;
  }

  .phases p { font-size: 1rem; line-height: 1.5; }

  /* Scope */
  .scope-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-5);
  }

  .scope h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.125rem;
    color: var(--color-navy);
    padding-bottom: var(--space-1);
    border-bottom: 3px solid var(--color-teal);
    margin-bottom: var(--space-1);
  }

  .scope-out h3 { border-bottom-color: var(--color-navy); }
  .scope ul { list-style: none; }

  .scope li {
    padding: var(--space-1) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .scope li:last-child { border-bottom: none; }
  .scope-out p { margin-top: var(--space-2); color: var(--color-text-secondary); }

  .scope-note {
    margin-top: var(--space-5);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: 1.375rem;
    line-height: 1.35;
    letter-spacing: var(--tracking-heading);
    color: var(--color-navy);
    max-width: 38ch;
  }

  /* Progress band */
  .progress { background: var(--color-deep-teal); padding: var(--space-12) 0; }

  .progress-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
  }

  .progress-kicker {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: #BFE9E0;
    margin-bottom: var(--space-2);
  }

  .progress h2 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-heading);
    line-height: 1.15;
    color: var(--color-white);
  }

  .progress-grid > p { font-size: var(--text-lead); color: rgba(255, 255, 255, 0.9); max-width: 52ch; }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-8);
    align-items: start;
  }

  .faq { display: flex; flex-direction: column; gap: var(--space-2); }

  .faq-item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: 1.0625rem;
    color: var(--color-navy);
  }

  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible { outline: 3px solid var(--color-teal); outline-offset: -3px; }
  .faq-item p { padding: 0 var(--space-3) var(--space-3); font-size: 1.0625rem; }

  .faq-icon { position: relative; flex-shrink: 0; width: 18px; height: 18px; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; background: var(--color-teal); transition: transform 200ms var(--ease), opacity 200ms var(--ease); }
  .faq-icon::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq-icon::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq-item[open] .faq-icon::after { transform: rotate(90deg); opacity: 0; }

  @media (max-width: 960px) {
    .situation-grid, .benefits-grid, .ninety-grid, .scope-grid, .progress-grid, .faq-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .situation { padding: var(--space-8) 0; }
    .progress { padding: var(--space-8) 0; }
    .statement { max-width: 18ch; }
  }

  @media (max-width: 480px) {
    .chain { padding-left: 60px; }
    .chain-node { left: -60px; width: 40px; height: 40px; }
    .chain li:not(:last-child)::before { left: -41px; top: 40px; }
    .chain h3 { font-size: 1.375rem; }
    .chain p { font-size: 1.0625rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon::before, .faq-icon::after { transition: none; }
  }
</style>
