---
import Base from '../../layouts/Base.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import CycleDiagram from '../../components/CycleDiagram.astro';
import CTAStrip from '../../components/CTAStrip.astro';

// Four reasons to buy, each with the specifics underneath.
const benefits = [
  {
    title: "Know where to start",
    body: "A required assessment of your business, your goals, and the tools you already use produces a personalized 90-day roadmap: the opportunities worth pursuing, in the order that makes sense.",
  },
  {
    title: "Make real progress",
    body: "Two 45-minute working sessions every month, six in your first 90 days, focused on moving your priorities forward.",
  },
  {
    title: "Have someone to ask",
    body: "Ongoing advisory access between sessions. Reach out through your dedicated communication channel and receive an initial substantive response within two business days.",
  },
  {
    title: "Know what's improving. Know what's next.",
    body: "We keep the roadmap current as priorities change, and each month you get a short written summary of what was done, what has improved, and what comes next. Where practical, we record a starting point so you can see the change.",
  },
];

const months = [
  { title: "Month 1: assess and plan", body: "The assessment, your priorities, and your personalized 90-day roadmap, followed by the first practical work." },
  { title: "Month 2: make progress", body: "We work through the priorities together and make practical progress on them." },
  { title: "Month 3: review and look ahead", body: "We continue the work, review what has improved, and establish the next priorities." },
  { title: "Then the next 90 days", body: "The roadmap is updated and the relationship continues month to month." },
];

const included = [
  "Practical guidance on AI tools, automation, forms, documents, custom applications, and software integrations: what to use, how to approach it, and what is worth doing.",
  "Limited-scope improvements made with you, such as refining AI workflows, improving prompts, configuring straightforward tools, reviewing automation logic, and troubleshooting existing processes.",
];

const scopedSeparately = [
  "Larger development projects and custom applications",
  "Production integrations",
  "Substantial automation builds",
  "Ongoing technical maintenance",
];

const faqs = [
  { q: "Do I need to know anything technical?", a: "No. You need to know your business. We bring the tools and the judgment about what is worth doing." },
  { q: "How is this different from using ChatGPT or Claude myself?", a: "ChatGPT and Claude are good tools, and we use them. What the relationship adds is someone who knows your business, helps decide what is worth doing first, sets it up around how you work, and checks back to see that it stuck." },
  { q: "What happens in a working session?", a: "We review your priorities, work through the next challenge together, make practical progress where we can, and agree what happens next." },
  { q: "What does it cost?", a: "Pricing depends on how you start. It is shared on your call and confirmed in writing before anything begins." },
];
---

<Base>
  <ServiceHero
    eyebrow="AI Concierge"
    headline="Your AI partner. Without the full-time hire."
    sub="An ongoing partnership to help you find where AI and automation make sense, turn opportunities into practical improvements, and keep moving forward. Built for business owners who want to make better use of technology without having to figure out every step themselves."
    primaryText="Book a 30-minute call"
    primaryHref="/contact"
    secondaryText="See how the first 90 days work &darr;"
    secondaryHref="#ninety"
    note="30 minutes. No pitch, no obligation."
  />

  <!-- The situation: one large statement, supporting text beside it -->
  <section class="sx-section situation reveal">
    <div class="sx-wrap situation-grid">
      <h2 class="statement">You know it could help. You do not have time to work out where.</h2>
      <div class="situation-text">
        <p>The tools change every month, and every vendor says theirs will save you hours. Someone still has to decide what is worth doing first, set it up properly, and check that it worked.</p>
        <p>Maybe you have already tried ChatGPT or an automation tool and it never became part of how the business runs. That is rarely a software problem. It is a question of what to do first, and who follows through.</p>
      </div>
    </div>
  </section>

  <!-- Four reasons: a connected sequence -->
  <section class="sx-section sx-section-alt benefits reveal">
    <div class="sx-wrap benefits-grid">
      <div class="benefits-head">
        <p class="sx-kicker">What you get</p>
        <h2 class="sx-title">An assessment, a roadmap, and a partner who stays on it.</h2>
      </div>
      <ol class="chain">
        {benefits.map((b, i) => (
          <li>
            <span class="chain-node" aria-hidden="true">{i + 1}</span>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 90 days: months beside the diagram -->
  <section class="sx-section ninety reveal" id="ninety">
    <div class="sx-wrap">
      <p class="sx-kicker">How it works</p>
      <h2 class="sx-title">The first 90 days, and then the next.</h2>
      <div class="ninety-grid">
        <ol class="phases">
          {months.map((m, i) => (
            <li>
              <span class="phase-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="diagram"><CycleDiagram /></div>
      </div>
    </div>
  </section>

  <!-- Two ways to begin -->
  <section class="sx-section sx-section-alt begin reveal">
    <div class="sx-wrap">
      <p class="sx-kicker">How to begin</p>
      <h2 class="sx-title">Two ways to begin. The same relationship either way.</h2>
      <p class="sx-lead">Every engagement starts with an assessment, because the roadmap needs it. How you start is up to you.</p>

      <div class="begin-grid">
        <article class="option option-a">
          <p class="option-tag">Recommended starting point</p>
          <h3>Start with 90 days</h3>
          <p>The assessment is included at no additional charge, in your first month. You commit to three monthly billing periods, the length of your first roadmap, then continue month to month. The commitment is set out in a written agreement.</p>
        </article>
        <article class="option option-b">
          <p class="option-tag option-tag-quiet">Flexible</p>
          <h3>Month to month</h3>
          <p>You pay a one-time assessment fee, then continue month to month from the start, with no initial commitment.</p>
        </article>
      </div>

      <p class="either-note">Both options include the same ongoing advisory relationship. The only difference is the initial commitment and how the assessment is paid for. You keep your completed assessment and roadmap whichever you choose.</p>
    </div>
  </section>

  <!-- Scope -->
  <section class="sx-section scope reveal">
    <div class="sx-wrap">
      <p class="sx-kicker">Scope</p>
      <h2 class="sx-title">Practical help every month. Clear scope when you need more.</h2>
      <div class="scope-grid">
        <div class="scope-in">
          <h3>Practical help, included</h3>
          <ul>
            {included.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="scope-out">
          <h3>Scoped and approved separately</h3>
          <ul>
            {scopedSeparately.map((t) => <li>{t}</li>)}
          </ul>
          <p>We can design and implement these directly, with specialist support where it helps. Each gets its own scope, price, and approval before any work starts.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sx-section sx-section-alt reveal">
    <div class="sx-wrap faq-grid">
      <h2 class="sx-title">Common questions about AI Concierge</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.q}</span><span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTAStrip
    headline="Start with a 30-minute conversation about where AI could help your business."
    sub="We'll talk about your business, the opportunities you're considering, and whether AI Concierge makes sense. No pitch, no obligation."
    buttonText="Book a 30-minute call"
    buttonHref="/contact"
  />
</Base>

<style>
  /* Situation */
  .situation { padding: calc(var(--space-12) + var(--space-3)) 0; }

  .situation-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: start;
  }

  .statement {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    color: var(--color-navy);
    max-width: 16ch;
  }

  .situation-text { padding-top: var(--space-1); }
  .situation-text p { font-size: var(--text-lead); color: var(--color-text-secondary); margin-bottom: var(--space-3); text-wrap: pretty; }

  /* Benefits as a connected chain */
  .benefits-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: start;
  }

  .chain { list-style: none; position: relative; padding-left: 72px; }
  .chain li { position: relative; padding-bottom: var(--space-5); }
  .chain > li:last-child { padding-bottom: 0; }

  .chain > li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: -51px;
    top: 44px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--color-teal), var(--color-teal-light));
    opacity: 0.55;
  }

  .chain-node {
    position: absolute;
    left: -72px;
    top: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-teal-light);
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1rem;
    box-shadow: 0 0 0 6px var(--color-warm-white-alt);
  }

  .chain h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.625rem;
    letter-spacing: var(--tracking-heading);
    color: var(--color-navy);
    line-height: 1.2;
    padding-top: 6px;
    margin-bottom: var(--space-1);
    text-wrap: balance;
  }

  .chain > li > p { font-size: 1.1875rem; line-height: 1.55; max-width: 48ch; text-wrap: pretty; }

  /* 90 days */
  .ninety-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-8);
    align-items: center;
  }

  .phases { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
  .phases li { display: flex; gap: var(--space-2); }

  .phase-num {
    flex-shrink: 0;
    width: 28px;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-teal);
  }

  .phases h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.0625rem;
    color: var(--color-navy);
    margin-bottom: 2px;
  }

  .phases p { font-size: 1rem; line-height: 1.5; }

  /* Two ways to begin */
  .begin-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: stretch;
  }

  .option {
    padding: 32px 32px;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-navy);
    border-radius: var(--radius-lg);
    background: transparent;
  }

  .option-a {
    background: var(--color-white);
    border-color: rgba(42, 125, 110, 0.4);
    border-top: 5px solid var(--color-teal);
    box-shadow: var(--shadow-md);
    padding: calc(var(--space-5)) var(--space-5);
  }

  .option h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-heading);
    color: var(--color-navy);
    margin-bottom: var(--space-1);
  }

  .option-a h3 { font-size: 1.625rem; }
  .option p:not(.option-tag) { font-size: 1.0625rem; line-height: 1.55; }

  .option-tag {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-deep-teal);
    margin-bottom: var(--space-1);
  }

  .option-tag-quiet { color: var(--color-text-secondary); }

  .either-note {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Scope */
  .scope-grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
  }

  .scope h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
    font-size: 1.125rem;
    color: var(--color-navy);
    padding-bottom: var(--space-1);
    border-bottom: 3px solid var(--color-teal);
    margin-bottom: var(--space-1);
  }

  .scope-out h3 { border-bottom-color: var(--color-navy); }
  .scope ul { list-style: none; }

  .scope li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.125rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .scope li:last-child { border-bottom: none; }
  .scope-out p { margin-top: var(--space-2); color: var(--color-text-secondary); }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-8);
    align-items: start;
  }

  .faq { display: flex; flex-direction: column; gap: var(--space-2); }

  .faq-item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading-medium);
    font-size: 1.0625rem;
    color: var(--color-navy);
  }

  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible { outline: 3px solid var(--color-teal); outline-offset: -3px; }
  .faq-item p { padding: 0 var(--space-3) var(--space-3); font-size: 1.0625rem; }

  .faq-icon { position: relative; flex-shrink: 0; width: 18px; height: 18px; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; background: var(--color-teal); transition: transform 200ms var(--ease), opacity 200ms var(--ease); }
  .faq-icon::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq-icon::after { top: 0; left: 8px; width: 2px; height: 18px; }
  .faq-item[open] .faq-icon::after { transform: rotate(90deg); opacity: 0; }

  @media (max-width: 960px) {
    .situation-grid, .benefits-grid, .ninety-grid, .begin-grid, .scope-grid, .faq-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .situation { padding: var(--space-8) 0; }
    .statement { max-width: 18ch; }

    .option, .option-a { padding: var(--space-3); }
  }

  @media (max-width: 640px) {
    .sx-section { padding: var(--space-5) 0 calc(var(--space-5) + var(--space-1)); }
    .situation { padding: var(--space-8) 0 var(--space-5); }
    .chain > li { padding-bottom: var(--space-3); }
    .ninety-grid, .begin-grid, .scope-grid { margin-top: var(--space-3); gap: var(--space-3); }
    .either-note { margin-top: var(--space-3); padding-top: var(--space-2); }
    .faq { gap: var(--space-1); }
  }

  @media (max-width: 480px) {
    .chain { padding-left: 60px; }
    .chain-node { left: -60px; width: 40px; height: 40px; }
    .chain > li:not(:last-child)::before { left: -41px; top: 40px; }
    .chain h3 { font-size: 1.375rem; }
    .chain > li > p { font-size: 1.0625rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon::before, .faq-icon::after { transition: none; }
  }
</style>
